generator client {
  provider = "prisma-client-js" // ← 
  // output   = "../generated/prisma" // no output → the output will be in node_modules
}

/**
 * Bad Docs - Invest time when application gets to advanced
 */
// generator zod {
//   provider = "prisma-zod-generator"
//   output   = "../lib/Schemas/generated"
// }

datasource db {
  provider = "postgresql"
  //@ts-ignore
  url      = env("DIRECT_URL")
}

// ================ ENUMS ================
enum UserRole {
  APPLICANT // Jobbsökande / profil som ska synas för rekryterare
  RECRUITER // Rekryterare / HR-person
  EMPLOYER // Företagsadministratör
  ADMIN // Systemadministratör
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum WorkArrangementEnum {
  remote_full_time
  remote_part_time
  hybrid_full_time
  hybrid_part_time
  onsite_full_time
  onsite_part_time
  flexible_full_time
  flexible_part_time
}

enum EmploymentEnum {
  full_time
  part_time
  contract
  temporary
  internship
  freelance
  trainee
}

enum SalaryTypeEnum {
  range
  fixed
  competitive
  negotiable
  not_specified
}

enum SalaryPeriodEnum {
  monthly
  annually
  hourly
  weekly
}

enum CreatedByEnum {
  system // t.ex. AI
  user // normal users (job seeker / recruiter)
  admin // administratör / moderator
}

enum JobSourceEnum {
  linkedin
  file_import
  api
  url
}

enum ProviderEnum {
  github
  google
  linkedin
}

enum UserRoleEnum {
  APPLICANT
  RECRUITER
  COMPANY_ADMIN
}

enum StatusUserJobProcesses {
  not_started
  started
  waiting_for_reply
  interview_booked
  interview_completed
  offer_received
  rejected
  hired
  archived
}

// ========================================================================

// NEW USER 
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified String?
  image         String?
  role          UserRole @default(APPLICANT)
  isSearching   Boolean  @default(true) // Is the user actively searching for a job

  /**
   * 🩵 Relation
   * All relations should be optional to begin with becuase we wont force how the user need to set-up the profile
   * if the user wants a insufficient profile- that is on them
   */
  contactInfos    ContactInfo[] // The contact infos of the user
  socialLinks     SocialLink[] // The social links of the user
  qualities       Quality[] // The qualities of the user
  knowledgeAreas  KnowledgeArea[] // The knowledge areas of the user
  workExperiences WorkExperience[] // The work experiences the user has
  educations      Education[] // The education the user has
  cvs             CV[] // Multiple CVs- but one will be default and more general
  coverLetters    CoverLetter[] // Multiple cover letters but one will be default and more general

  preferenceSets PreferenceSet[] // User preference for a job- this is shared with job postings and make it easier to filter

  applications JobApplicants[] // Job the user has applied to
  userProcess  UserProcess[] // Process the user has started 

  company                  Company?                  @relation("CompanyUsers", fields: [companyId], references: [id])
  companyId                String?
  createdJobPostings       CreatedJobPosting[]       @relation("UserCreatedJobPostings")
  userPipelineStepComments UserPipelineStepComment[]
  processSteps             ProcessStep[]
  processes                Process[]
  todos                    Todo[]
  repoParticipants         RepoParticipant[]
  providers                Provider[]

  @@map("users")
}

model ContactInfo {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  type       String // e.g., "phone", "address"
  value      String // e.g., "+46 70 123 45 67", "Stockholm, Sweden"
  country    String?
  region     String?
  city       String?
  postalCode String?

  @@index([userId])
  @@map("contact_infos")
}

model SocialLink {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  platform String // e.g., LinkedIn, GitHub
  url      String

  @@unique([userId, platform, url], name: "unique_user_social_link")
  @@index([userId])
  @@map("social_links")
}

model Quality {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name  String
  level String? // e.g., Beginner, Intermediate, Advanced

  @@unique([userId, name, level], name: "unique_user_quality")
  @@index([userId])
  @@map("qualities")
}

model KnowledgeArea {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name        String // e.g., TypeScript, Project Management
  level       String? // Optional: Beginner, Intermediate, Advanced
  years       Float? // Optional: Years of experience
  certificate String? // Optional certificate name

  @@index([userId])
  @@map("knowledge_areas")
}

model WorkExperience {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  companyName String
  role        String
  startDate   DateTime
  endDate     DateTime?
  description String?

  @@index([userId])
  @@map("work_experiences")
}

model Education {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  description  String?

  // Relation till flera filer
  files EducationFile[]

  @@index([userId])
  @@map("educations")
}

model EducationFile {
  id          String    @id @default(cuid())
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)
  educationId String

  fileUrl   String // t.ex. länk till S3 
  fileType  String? // t.ex. "Diploma", "Transcript"
  createdAt DateTime @default(now())

  @@index([educationId])
  @@map("education_files")
}

model CV {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  fileUrl   String
  createdAt DateTime @default(now())
  isDefault Boolean  @default(false) // Mark default CV

  @@unique([userId, fileUrl], name: "unique_user_cv_file")
  @@index([userId])
  @@map("cvs")
}

model CoverLetter {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  fileUrl   String?
  text      String?
  createdAt DateTime @default(now())
  isDefault Boolean  @default(false) // Mark default cover letter

  @@index([userId])
  @@map("cover_letters")
}

/// Login method (Google, GitHub, etc.) – stores external ID + tokens
model Provider {
  id                String       @id @default(cuid())
  userId            String
  provider          ProviderEnum
  providerAccountId String // external account ID

  // Separerad token-information
  token Token?
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("providers")
}

model Token {
  id            String  @id @default(cuid())
  providerId    String  @unique
  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("Tokens")
}

// ============================================
// COMPANY (för rekryterare som tillhör företag)
// ============================================

model Company {
  id          String       @id @default(cuid())
  name        String
  logo        String?
  users       User[]       @relation("CompanyUsers") // matchar relation-namnet i User
  jobPostings JobPosting[]
}

// ==============================================================
// JOB POSTING – 100% INDEPENDENT
// ==============================================================

model JobPosting {
  id             String  @id @default(cuid())
  title          String
  companyName    String
  companyLogo    String?
  jobPostingUrl  String  @unique
  jobDescription String  @db.Text
  markdownText   String  @db.Text
  status         String  @default("active")
  endsAt         String? // ISO string
  createdAt      String  @default(dbgenerated("now()"))
  updatedAt      String  @default(dbgenerated("now()"))

  createdJobPosting CreatedJobPosting?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  preferenceSet PreferenceSet[] // pref / demands for the job application

  jobApplicants JobApplicants[]
  userProcesses UserProcess[]

  @@index([status, endsAt, companyId, title])
  @@map("job_postings")
}

model PreferenceSet {
  id String @id @default(cuid())

  // Koppling till kandidat (om det är kandidatens egna preferenser)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // Koppling till jobbannons (om det är rekryterarens preferens/krav)
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Alla detaljtabeller kopplas hit
  languages          Language[]
  locations          Location[]
  workArrangements   WorkArrangement[]
  employmentTypes    EmploymentType[]
  salaries           Salary[]
  benefits           Benefit[]
  requirements       Requirement[]
  merits             Merit[]
  applicantQualities ApplicantQuality[]

  @@index([userId])
  @@index([jobPostingId])
  @@map("preference_sets")
}

/**
 * All down below should be connected with prefrence above
 */
model Language {
  id String @id @default(cuid())

  // Koppling till kandidat eller jobb
  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  language String
  level    String? // ex. Beginner, Intermediate, Advanced, Expert
  isNative Boolean? @default(false)

  @@index([preferenceSetId])
  @@index([language])
  @@index([level])
  @@index([isNative])
  @@map("language_skills")
}

model Location {
  id String @id @default(cuid())

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  city     String?
  region   String?
  country  String  @default("Sverige")
  isRemote Boolean @default(false)
  lat      Float?
  lng      Float?

  @@index([city])
  @@index([region])
  @@index([country])
  @@index([isRemote])
  @@map("locations")
}

model Requirement {
  id          String @id @default(cuid())
  requirement String

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  @@index([preferenceSetId])
  @@map("job_posting_requirements")
}

model Merit {
  id    String @id @default(cuid())
  merit String

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  @@index([preferenceSetId])
  @@map("job_posting_merits")
}

model ApplicantQuality {
  id      String @id @default(cuid())
  quality String

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  @@index([preferenceSetId])
  @@map("job_posting_applicant_qualities")
}

model WorkArrangement {
  id String @id @default(cuid())

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  mode WorkArrangementEnum

  @@index([mode])
  @@index([preferenceSetId])
  @@map("work_arrangements")
}

model EmploymentType {
  id String @id @default(cuid())

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  type EmploymentEnum

  @@index([type])
  @@index([preferenceSetId])
  @@map("employment_types")
}

model Salary {
  id String @id @default(cuid())

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  minAmount Float?
  maxAmount Float?
  currency  String  @default("SEK")
  period    String  @default("monthly")
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexering för snabb filtrering
  @@index([minAmount, maxAmount])
  @@index([currency])
  @@index([period])
  @@index([preferenceSetId])
  @@map("salaries")
}

model Benefit {
  id String @id @default(cuid())

  preferenceSet   PreferenceSet? @relation(fields: [preferenceSetId], references: [id], onDelete: Cascade)
  preferenceSetId String?

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([preferenceSetId])
  @@map("benefits")
}

/**
 * Handle
 * Did we scrape it by our self or via user or did a recruiter create a job posting
 */
model CreatedJobPosting {
  id           String     @id @default(cuid())
  jobPostingId String     @unique
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  createdByType CreatedByEnum
  createdById   String?
  createdBy     User?         @relation("UserCreatedJobPostings", fields: [createdById], references: [id])

  source     JobSourceEnum?
  importedAt DateTime?

  @@map("created_job_postings")
}

// ==============================================================
// WHO APPLIED TO THE JOB
// ==============================================================

/**
 * ƒ This should hold more meta data for the future to be more helpful for recruiters
 * This table is for connecting users with job postings they have applied to
 */
model JobApplicants {
  id           String @id @default(cuid())
  userId       String
  jobPostingId String

  status    String  @default("Skickat")
  appliedAt String
  gotJob    Boolean @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@index([userId])
  @@index([jobPostingId])
  @@index([status])
  @@map("job_applicants")
}

/**
 * Connect a Process with a jobPosting
 */
model UserProcess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      StatusUserJobProcesses @default(not_started)
  startedAt   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  completedAt String?

  steps UserProcessStep[]

  jobPostingId String
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  processId String?
  process   Process? @relation(fields: [processId], references: [id], onDelete: Cascade)

  todos TodoUserProcess[]

  @@unique([userId, jobPostingId])
  @@index([userId])
  @@index([jobPostingId])
  @@index([processId])
  @@index([status])
  @@map("user_processes")
}

/// User’s progress on a specific step
model UserProcessStep {
  id            String  @id @default(cuid())
  userProcessId String
  stepId        String?

  isExecuted Boolean @default(false)
  executedAt String? // will be null if not executed

  comments UserPipelineStepComment[]

  // Should not be used in include

  process UserProcess  @relation(fields: [userProcessId], references: [id], onDelete: Cascade)
  step    ProcessStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId])
  @@unique([userProcessId, stepId])
  @@index([userProcessId])
  @@index([stepId])
  @@map("user_process_step")
}

/// Comment on a pipeline step
model UserPipelineStepComment {
  id                 String @id @default(cuid())
  userPipelineStepId String
  userId             String

  comment   String @db.Text
  createdAt String

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  step UserProcessStep @relation(fields: [userPipelineStepId], references: [id], onDelete: Cascade)

  @@map("user_process_comments")
}

// ==============================================================
// PIPELINE TEMPLATES

// ==============================================================

/**
 * Collection of reusable pipelines (e.g. "Standard Job Application Pipeline")
 * One template can be used by many users and many UserJobProcess records.
 */
model Process {
  id String @id @default(cuid()) /// Primary key

  name        String /// Display name in UI (e.g. "Default Pipeline")
  description String? @db.Text /// Optional longer description
  icon        String? /// Lucide icon name for UI

  ownerId String? @default("system") //   system or userID
  user    User?   @relation(fields: [ownerId], references: [id])

  isTemplate Boolean
  isPublic   Boolean @default(false)

  /// All steps that belong to this pipeline template
  steps ProcessStep[]

  /// All user processes that are currently using this process
  processes UserProcess[]

  @@unique([id, ownerId])
  @@map("process_templates")
}

/**
 * One step inside a PipelineTemplate (the reusable definition)
 * This is the "master" version – never changed by a user directly.
 */
model ProcessStep {
  id        String  @id @default(cuid()) /// Primary key
  processId String /// FK to PipelineTemplate
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  title       String
  description String

  icon  String? // Optional Lucide icon
  order Int // order inside the pipeline

  // 
  triggers TriggerDefinition[]
  actions  ActionDefinition[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// All user-specific instances of this step (one per UserJobProcess)
  userProcessSteps UserProcessStep[]

  @@index([processId])
  @@index([userId])
  @@map("process_step")
}

/**
 * READY-MADE ACTION TEMPLATES
 * These are the actual actions users see and pick in the UI.
 * One ActionCatalog entry can power many ActionDefinitions
 * (e.g. "Send email" → "Friendly follow-up", "Thank you after interview", etc.).
 */
model ActionDefinition {
  id   String @id @default(cuid())
  name String

  isPublic Boolean @default(false)
  order    Int

  config Json

  // Relationals
  stepId String?
  step   ProcessStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("action_definition")
}

// ==============================================================
// TRIGGERS/EVENTS TEMPLATES
// ==============================================================
/**
 * The machine-readable keys for comparison operators used in TriggerCondition.
 * These define how the comparisonValue should be compared against the actual fieldKey value.
 */
enum ComparisonOperatorEnum {
  // Exact comparisons (numeric and string)
  EQ // Equal to
  NE // Not equal to

  // Numeric/Time comparisons
  GT // Greater than
  GTE // Greater than or equal to
  LT // Less than
  LTE // Less than or equal to

  // String comparisons
  CONTAINS // Contains (case-sensitive)
  STARTS_WITH // Starts with
  ENDS_WITH // Ends with

  // Array Operators
  IN // Value is within the list/array
  NOT_IN // Value is not within the list/array

  // Presence (for booleans and null checks)
  IS_NULL // Field value is null
  IS_NOT_NULL // Field value is not null
}

enum CombinatorEnum {
  AND
  OR
}

enum TriggerCategoryCodeEnum {
  TIME_BASED
  STATUS_CHANGE
  STATUS_EVENT
  MANUAL
}

/**
 * Machine-readable keys for all core trigger events.
 * Used in code (Go/TypeScript) when publishing events or scheduling jobs.
 */
enum TriggerEventCode {
  /**
   * TRIGGER AFTER X DAYS
   * This could be used, if Y hasen´t happened in X days- trigger this
   */
  REMINDER // Implemented
  EMAIL_SENT // Implemented
  EMAIL_RECEIVED // Implemented
  NO_REPLY // Implemented
  INTERVIEW_BOOKED
  INTERVIEW_COMPLETED
  INTERVIEW_OFFER
  APPLICATION_SUBMITTED
  APPLICATION_REJECTED
  APPLICATION_RECEIVED
  OFFER_RECEIVED
  MANUAL_TRIGGER
  STEP_COMPLETED
  STEP_SKIPPED
}

// --------------------------------------------------------------

// --------------------------------------------------------------

/**
 * READY-MADE TRIGGER TEMPLATES (Uppdaterad för Nestling)
 * Definierar en regel och är ägare till de logiska grupperna.
 */
model TriggerDefinition {
  id String @id @default(cuid())

  order     Int
  isPublic  Boolean @default(false)
  createdBy String

  triggerCode String
  executeWhen TriggerEventCode?
  executeAt   String?

  combinator CombinatorEnum?
  config     Json
  conditions Conditional[]

  expiration String?

  stepId String?
  step   ProcessStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([triggerCode])
  @@index([executeAt])
  @@map("trigger_definition")
}

/**
 * NEW MODEL: The individual conditions (if-statements) som nu tillhör en TriggerGroup.
 * Denna modell är ett LÖV i logikträdet och länkar ENDAST till sin föräldragrupp.
 */
model Conditional {
  id String @id @default(cuid())

  triggerId String
  trigger   TriggerDefinition @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  fieldKey        String
  fieldKeyLabel   String
  operator        ComparisonOperatorEnum
  comparisonValue String
  combinator      CombinatorEnum?

  @@map("trigger_condition")
}

/**
 * Machine-readable keys for all core actions.
 * Used in code when executing actions.
 */
enum ActionKey {
  SEND_EMAIL_REMINDER
  CREATE_CALENDAR_EVENT
  CALL_REMINDER
  SEND_SMS
  WEBHOOK
  UPDATE_STEP_STATUS
}

enum TodoItemTypeEnum {
  TEXT
  USER_PROCESS
}

// ==============================================================
// TODO SYSTEM
// ==============================================================

model Todo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items         TodoItem[]
  userProcesses TodoUserProcess[]

  @@index([userId])
  @@index([completed])
  @@index([dueDate])
  @@map("todos")
}

model TodoItem {
  id      String           @id @default(cuid())
  todoId  String
  todo    Todo             @relation(fields: [todoId], references: [id], onDelete: Cascade)
  type    TodoItemTypeEnum
  content String           @db.Text // Text content or userProcessId
  order   Int

  @@index([todoId])
  @@map("todo_items")
}

model TodoUserProcess {
  id            String      @id @default(cuid())
  todoId        String
  userProcessId String
  todo          Todo        @relation(fields: [todoId], references: [id], onDelete: Cascade)
  userProcess   UserProcess @relation(fields: [userProcessId], references: [id], onDelete: Cascade)

  @@unique([todoId, userProcessId])
  @@index([todoId])
  @@index([userProcessId])
  @@map("todo_user_processes")
}

// ==============================================================
// ANALYSIS SYSTEM
// ==============================================================
/**
 * Idea is to ba able to see if a repo has been analysed before.
 * If another user want to analyse the same repo we can just link it to the same collection ID
 */
model AnalyzedRepo {
  id String @id @default(uuid())

  repoId        String   @unique // ID from github / gitbucket / 
  repoName      String
  repoUrl       String?
  repoSize      Int?
  repoIsPrivate Boolean?

  branch       String?
  codeLanguage String?

  collectionName String? @unique

  createdAt DateTime @default(now()) // will always be the same as ingest date
  updatedAt DateTime @updatedAt // Will auto update when we update the table

  analyseText      String?
  repoParticipants RepoParticipant[]

  @@index(repoUrl)
  @@index(repoName)
  @@index([repoId, repoName, repoUrl, collectionName])
  @@map("analyzed_repos")
}

model RepoParticipant {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  username String
  isOwner  Boolean @default(false)

  // meta data
  contributionLevel String?
  commitCount       Int?
  linesAdded        Int?
  linesDeleted      Int?
  score             Float?

  analyzedRepoId String?
  analyzedRepo   AnalyzedRepo? @relation(fields: [analyzedRepoId], references: [id], onDelete: SetNull)

  @@unique([analyzedRepoId, userId])
  @@index([userId, analyzedRepoId], name: "idx_user_repo_unique")
  @@index([userId])
  @@index([analyzedRepoId])
  @@map("repo_participants")
}
